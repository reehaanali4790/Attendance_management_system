# =========================================================
# Attendance Management System - Environment Configuration
# =========================================================

# Database (Supabase PostgreSQL recommended for production)
#
# Option A — single URL (password must be URL-encoded if it contains @, *, etc.)
# Example password Reh@315389* becomes Reh%40315389%2A
# Pooler URL (recommended — works on Railway and local networks):
DATABASE_URL=postgresql://postgres.pdljzinaqzfsxpnjcgla:YOUR_URL_ENCODED_PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
#
# Option B — separate vars (password can contain any characters, no encoding needed)
# POSTGRES_HOST=aws-0-ap-northeast-1.pooler.supabase.com
# POSTGRES_USER=postgres.pdljzinaqzfsxpnjcgla
# POSTGRES_PASSWORD=your_password_here
# POSTGRES_PORT=5432
# POSTGRES_DB=postgres

# Local development fallback (if DATABASE_URL is not set):
# sqlite:///./attendance.db

# OpenAI API Key (Required for Voice Assistant, Whisper STT, GPT-4o, and TTS)
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# OpenAI Text-To-Speech Voice Accent & Model
OPENAI_TTS_VOICE=sage
OPENAI_TTS_MODEL=tts-1
# Set to true for maximum speed on understanding/synthesis (romanization always uses LLM for quality)
OPENAI_FAST_MODE=false

# Server port (Railway sets PORT automatically)
PORT=8000

# Authentication (web dashboard login)
JWT_SECRET_KEY=change-this-to-a-long-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ADMIN_USERNAME=admin@jmtraders.com
ADMIN_PASSWORD=Admin@AMS2026
